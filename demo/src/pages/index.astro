---
import Layout from '../layouts/Layout.astro';

import Autoplay from '../swiper-components/Autoplay.astro'
import DemoAutoheight from '../swiper-components/DemoAutoheight.astro'
import DemoAutoplay from '../swiper-components/DemoAutoplay.astro'
import DemoAutoplayProgress from '../swiper-components/DemoAutoplayProgress.astro'
import DemoCentered from '../swiper-components/DemoCentered.astro'
import DemoCenteredAuto from '../swiper-components/DemoCenteredAuto.astro'
import DemoChangeDirection from '../swiper-components/DemoChangeDirection.astro'
import DemoCssMode from '../swiper-components/DemoCssMode.astro'
import DemoCustomPlugin from '../swiper-components/DemoCustomPlugin.astro'
import DemoDefault from '../swiper-components/DemoDefault.astro'
import DemoEffectCards from '../swiper-components/DemoEffectCards.astro'
import DemoEffectCoverFlow from '../swiper-components/DemoEffectCoverFlow.astro'
import DemoEffectCreative from '../swiper-components/DemoEffectCreative.astro'
import DemoEffectCube from '../swiper-components/DemoEffectCube.astro'
import DemoEffectFade from '../swiper-components/DemoEffectFade.astro'
import DemoEffectFlip from '../swiper-components/DemoEffectFlip.astro'
// import DemoFirstSlide from '../swiper-components/DemoFirstSlide.astro'
import DemoFreeMode from '../swiper-components/DemoFreeMode.astro'
import DemoGrabCursor from '../swiper-components/DemoGrabCursor.astro'
import DemoGrid from '../swiper-components/DemoGrid.astro'
import DemoHashNavigation from '../swiper-components/DemoHashNavigation.astro'
import DemoHistory from '../swiper-components/DemoHistory.astro'
import DemoInfiniteLoop from '../swiper-components/DemoInfiniteLoop.astro'
import DemoKeyboardControl from '../swiper-components/DemoKeyboardControl.astro'
import DemoLazyLoadImages from '../swiper-components/DemoLazyLoadImages.astro'
import DemoManipulation from '../swiper-components/DemoManipulation.astro'
import DemoMousewheelControl from '../swiper-components/DemoMousewheelControl.astro'
import DemoMultipleSwipers from '../swiper-components/DemoMultipleSwipers.astro'
import DemoNavigation from '../swiper-components/DemoNavigation.astro'
import DemoNested from '../swiper-components/DemoNested.astro'
import DemoPagination from '../swiper-components/DemoPagination.astro'
import DemoPaginationCustom from '../swiper-components/DemoPaginationCustom.astro'
import DemoPaginationDynamic from '../swiper-components/DemoPaginationDynamic.astro'
import DemoPaginationFraction from '../swiper-components/DemoPaginationFraction.astro'
import DemoPaginationProgress from '../swiper-components/DemoPaginationProgress.astro'
import DemoParallax from '../swiper-components/DemoParallax.astro'
import DemoRatioBreakpoints from '../swiper-components/DemoRatioBreakpoints.astro'
import DemoResponsiveBreakpoints from '../swiper-components/DemoResponsiveBreakpoints.astro'
import DemoRewind from '../swiper-components/DemoRewind.astro'
import DemoRtl from '../swiper-components/DemoRtl.astro'
import DemoScrollContainer from '../swiper-components/DemoScrollContainer.astro'
import DemoScrollbar from '../swiper-components/DemoScrollbar.astro'
// import DemoSecondSlide from '../swiper-components/DemoSecondSlide.astro'
import DemoSlideableMenu from '../swiper-components/DemoSlideableMenu.astro'
import DemoSlidesPerGroupSkip from '../swiper-components/DemoSlidesPerGroupSkip.astro'
import DemoSlidesPerView from '../swiper-components/DemoSlidesPerView.astro'
import DemoSlidesPerViewAuto from '../swiper-components/DemoSlidesPerViewAuto.astro'
import DemoSpaceBetween from '../swiper-components/DemoSpaceBetween.astro'
import DemoThumbsGallery from '../swiper-components/DemoThumbsGallery.astro'
import DemoThumbsGalleryLoop from '../swiper-components/DemoThumbsGalleryLoop.astro'
import DemoVertical from '../swiper-components/DemoVertical.astro'
import DemoVirtualSlides from '../swiper-components/DemoVirtualSlides.astro'
import DemoWatchSlidesVisibility from '../swiper-components/DemoWatchSlidesVisibility.astro'
import DemoZoom from '../swiper-components/DemoZoom.astro'
import IndexExample from '../swiper-components/IndexExample.astro'
import Navigation from '../swiper-components/Navigation.astro'
import Pagination from '../swiper-components/Pagination.astro'
import Thumbnail from '../swiper-components/Thumbnail.astro'

---

<Layout>
	<div class="grid">
		<div id="test-Autoplay"> <Autoplay />	</div>
		<div id="test-DemoAutoheight"> <DemoAutoheight /> </div>
		<div id="test-DemoAutoplay"> <DemoAutoplay /> </div>
		<div id="test-DemoAutoplayProgress"> <DemoAutoplayProgress /> </div>
		<div id="test-DemoCentered"> <DemoCentered /> </div>
		<div id="test-DemoCenteredAuto"> <DemoCenteredAuto /> </div>
		<div id="test-DemoChangeDirection"> <DemoChangeDirection /> </div>
		<div id="test-DemoCssMode"> <DemoCssMode /> </div>
		<div id="test-DemoCustomPlugin"> <DemoCustomPlugin /> </div>
		<div id="test-DemoDefault"> <DemoDefault /> </div>
		<div id="test-DemoEffectCards"> <DemoEffectCards /> </div>
		<div id="test-DemoEffectCoverFlow"> <DemoEffectCoverFlow /> </div>
		<div id="test-DemoEffectCreative"> <DemoEffectCreative /> </div>
		<div id="test-DemoEffectCube"> <DemoEffectCube /> </div>
		<div id="test-DemoEffectFade"> <DemoEffectFade /> </div>
		<div id="test-DemoEffectFlip"> <DemoEffectFlip /> </div>
		{/*<DemoFirstSlide /> */}
		<div id="test-DemoFreeMode"> <DemoFreeMode /> </div>
		<div id="test-DemoGrabCursor"> <DemoGrabCursor /> </div>
		<div id="test-DemoGrid"> <DemoGrid /> </div>
		<div id="test-DemoHashNavigation"> <DemoHashNavigation /> </div>
		<div id="test-DemoHistory"> <DemoHistory /> </div>
		<div id="test-DemoInfiniteLoop"> <DemoInfiniteLoop /> </div>
		<div id="test-DemoKeyboardControl"> <DemoKeyboardControl /> </div>
		<div id="test-DemoLazyLoadImages"> <DemoLazyLoadImages /> </div>
		<div id="test-DemoManipulation"> <DemoManipulation /> </div>
		<div id="test-DemoMousewheelControl"> <DemoMousewheelControl /> </div>
		<div id="test-DemoMultipleSwipers"> <DemoMultipleSwipers /> </div>
		<div id="test-DemoNavigation"> <DemoNavigation /> </div>
		<div id="test-DemoNested"> <DemoNested /> </div>
		<div id="test-DemoPagination"> <DemoPagination /> </div>
		<div id="test-DemoPaginationCustom"> <DemoPaginationCustom /> </div>
		<div id="test-DemoPaginationDynamic"> <DemoPaginationDynamic /> </div>
		<div id="test-DemoPaginationFraction"> <DemoPaginationFraction /> </div>
		<div id="test-DemoPaginationProgress"> <DemoPaginationProgress /> </div>
		<div id="test-DemoParallax"> <DemoParallax /> </div>
		<div id="test-DemoRatioBreakpoints"> <DemoRatioBreakpoints /> </div>
		<div id="test-DemoResponsiveBreakpoints"> <DemoResponsiveBreakpoints /> </div>
		<div id="test-DemoRewind"> <DemoRewind /> </div>
		<div id="test-DemoRtl"> <DemoRtl /> </div>
		<div id="test-DemoScrollContainer"> <DemoScrollContainer /> </div>
		<div id="test-DemoScrollbar"> <DemoScrollbar /> </div>
		{/*<DemoSecondSlide /> */}
		<div id="test-DemoSlideableMenu"> <DemoSlideableMenu /> </div>
		<div id="test-DemoSlidesPerGroupSkip"> <DemoSlidesPerGroupSkip /> </div>
		<div id="test-DemoSlidesPerView"> <DemoSlidesPerView /> </div>
		<div id="test-DemoSlidesPerViewAuto"> <DemoSlidesPerViewAuto /> </div>
		<div id="test-DemoSpaceBetween"> <DemoSpaceBetween /> </div>
		<div id="test-DemoThumbsGallery"> <DemoThumbsGallery /> </div>
		<div id="test-DemoThumbsGalleryLoop"> <DemoThumbsGalleryLoop /> </div>
		<div id="test-DemoVertical"> <DemoVertical /> </div>
		<div id="test-DemoVirtualSlides"> <DemoVirtualSlides /> </div>
		<div id="test-DemoWatchSlidesVisibility"> <DemoWatchSlidesVisibility /> </div>
		<div id="test-DemoZoom"> <DemoZoom /> </div>
		<div id="test-IndexExample"> <IndexExample /> </div>
		<div id="test-Navigation"> <Navigation /> </div>
		<div id="test-Pagination"> <Pagination /> </div>
		<div id="test-Thumbnail"> <Thumbnail /> </div>
	</div>
</Layout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
</style>